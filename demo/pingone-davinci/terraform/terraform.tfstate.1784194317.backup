 for=\\\"passcode\\\"\\u003eVerification Code\\u003c/label\\u003e\\n                            \\u003c/div\\u003e\\n                           \\n                            \\u003cdiv class=\\\"d-flex flex-column\\\"\\u003e\\n                                \\u003cbutton id=\\\"submit\\\" type=\\\"submit\\\" class=\\\"btn btn-primary mb-3\\\" data-skcomponent=\\\"skbutton\\\"\\n                                    data-skbuttontype=\\\"form-submit\\\" data-skform=\\\"otp-form\\\" data-skbuttonvalue=\\\"VERIFY\\\"\\u003e\\n                                    Continue\\n                                \\u003c/button\\u003e\\n                                \\u003cbutton id=\\\"resend\\\" type=\\\"button\\\" class=\\\"btn btn-link mb-3\\\" data-skcomponent=\\\"skbutton\\\"\\n                                    data-skbuttontype=\\\"next-event\\\" data-skbuttonvalue=\\\"RESEND\\\"\\u003e\\n                                    Resend verification code\\n                                \\u003c/button\\u003e\\n                            \\u003c/div\\u003e\\n                        \\u003c/form\\u003e\\n                    \\u003c/div\\u003e\\n                \\u003c/main\\u003e\\n            \\u003c/div\\u003e\\n        \\u003c/div\\u003e\\n    \\u003c/div\\u003e\\n\\u003c/div\\u003e\"},\"customScript\":{\"value\":\"/**\\n * Sets focus to the DOM element specified by its ID.\\n * @param {string} id - The ID of the DOM element to focus.\\n */\\nconst setFieldFocus = (id) =\\u003e {\\n    const element = document.getElementById(id);\\n    if (element) {\\n        element.focus();\\n    } else {\\n        console.log(`Element with ID ${id} not found.`);\\n    }\\n};\\n\\n/**\\n * Initializes the application by setting the focus to a specific field.\\n */\\nconst start = () =\\u003e {\\n    setFieldFocus(\\\"passcode\\\");\\n};\\n\\n// Ensure the script runs after the DOM is fully loaded\\nif (document.readyState === \\\"loading\\\") {\\n    document.addEventListener(\\\"DOMC