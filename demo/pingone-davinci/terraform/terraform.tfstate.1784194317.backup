     \\\"text\\\": \\\"code\\\"\\n          }\\n        ]\\n      },\\n      {\\n        \\\"text\\\": \\\"\\\"\\n      },\\n      {\\n        \\\"text\\\": \\\" \\\"\\n      },\\n      {\\n        \\\"text\\\": \\\"\\\"\\n      },\\n      {\\n        \\\"type\\\": \\\"link\\\",\\n        \\\"src\\\": \\\"pingIdentity.svg\\\",\\n        \\\"url\\\": \\\"message\\\",\\n        \\\"data\\\": \\\"{{local.k1w74hwabz.payload.error.message}}\\\",\\n        \\\"tooltip\\\": \\\"{{local.k1w74hwabz.payload.error.message}}\\\",\\n        \\\"children\\\": [\\n          {\\n            \\\"text\\\": \\\"message\\\"\\n          }\\n        ]\\n      },\\n      {\\n        \\\"text\\\": \\\"\\\"\\n      }\\n    ]\\n  }\\n]\"},\"errorReason\":{\"value\":\"[\\n  {\\n    \\\"children\\\": [\\n      {\\n        \\\"text\\\": \\\"\\\"\\n      },\\n      {\\n        \\\"text\\\": \\\"\\\"\\n      },\\n      {\\n        \\\"type\\\": \\\"link\\\",\\n        \\\"src\\\": \\\"pingIdentity.svg\\\",\\n        \\\"url\\\": \\\"details\\\",\\n        \\\"data\\\": \\\"{{local.k1w74hwabz.payload.error.details}}\\\",\\n        \\\"tooltip\\\": \\\"{{local.k1w74hwabz.payload.error.details}}\\\",\\n        \\\"children\\\": [\\n          {\\n            \\\"text\\\": \\\"details\\\"\\n          }\\n        ]\\n      },\\n      {\\n        \\\"text\\\": \\\"\\\"\\n      }\\n    ]\\n  }\\n]\"},\"nodeDescription\":{},\"nodeTitle\":{\"value\":\"Issue updating user's MFA device to active\"}},\"status\":\"configured\",\"type\":\"action\"},\"grabbable\":true,\"group\":\"nodes\",\"locked\":false,\"pannable\":false,\"position\":{\"x\":1838,\"y\":2434},\"removed\":false,\"selectable\":true,\"selected\":false},{\"classes\":\"\",\"data\":{\"capabilityName\":\"updateAnnotationProperties\",\"connectionId\":\"921bfae85c38ed45045e07be703d86b8\",\"connectorId\":\"annotationConnector\",\"id\":\"46b6b1crz1\",\"idUnique\":\"va2myvlghx\",\"name\":\"Annotation\",\"nodeType\":\"ANNOTATION\",\"properties\":{\"annotation\":{\"value\":\"PingOne Passwordless Registration (Passkey)\"},\"annotationTextColor\":{\"value\":\"#ffffffff\"},\"backgroundColor\":{\"value\":\"#4462edff\"},\"cornerRadius\":{\"value\":8},\"fontFamily\":{\"value\":\"sans-serif\"},\"fontSize\":{\"value\":16},\"fontStyle\":{\"value\":\"bold\"},\"width\":{\"value\":2350}},\"status\":\"configured\",\"type\":\"action\"},\"grabbable\":true,\"group\":\"nodes\",\"locked\":false,\"pannable\":false,\"position\":{\"x\":218,\"y\":274},\"removed\":false,\"selectable\":true,\"selected\":false},{\"classes\":\"\",\"data\":{\"capabilityName\":\"customHTMLTemplate\",\"connectionId\":\"867ed4363b2bc21c860085ad2baa817d\",\"connectorId\":\"httpConnector\",\"id\":\"pg0rzcvk90\",\"isDisabled\":false,\"label\":\"HTTP\",\"name\":\"Http\",\"nodeType\":\"CONNECTION\",\"properties\":{\"continueButtonLabel\":{\"value\":\"[\\n  {\\n    \\\"children\\\": [\\n      {\\n        \\\"text\\\": \\\"Continue\\\"\\n      }\\n    ]\\n  }\\n]\"},\"customCSS\":{\"value\":\".hidden-button{\\n    display: none;\\n}\\n\\n.hidden{\\n    display: none;\\n}\"},\"customHTML\":{\"value\":\"\\u003cdiv class=\\\"end-user-nano\\\"\\u003e\\n  \\u003cdiv\\n    class=\\\"bg-light d-flex flex-column justify-content-center align-items-center position-absolute top-0 start-0 bottom-0 end-0\\\"\\u003e\\n    \\u003cdiv style=\\\"max-width: 400px; width: 100%\\\"\\u003e\\n      \\u003cdiv class=\\\"card shadow mb-5\\\"\\u003e\\n        \\u003cmain aria-labelledby=\\\"title\\\"\\u003e\\n          \\u003cdiv class=\\\"card-body p-5 d-flex flex-column\\\"\\u003e\\n            \\u003cimg class=\\\"companyLogo align-self-center mb-5\\\" src=\\\"{{global.variables.companyLogo}}\\\" alt=\\\"{{global.variables.companyName}}\\\" /\\u003e\\n\\n            \\u003ch1 id=\\\"title\\\" class=\\\"text-center mb-4\\\"\\u003e\\n              \\u003ci class=\\\"mdi mdi-account-key-outline text-dark fs-1\\\" aria-hidden=\\\"true\\\"\\u003e\\u003c/i\\u003e\\n              {{title}}\\n            \\u003c/h1\\u003e\\n\\n            {{#if text}}\\n            \\u003cp class=\\\"text-muted text-center\\\"\\u003e{{text}}\\u003c/p\\u003e\\n            {{/if}}\\n\\n            \\u003cp id=\\\"errorMsg\\\" class=\\\"text-danger\\\" data-id=\\\"feedback\\\"\\u003e\\u003c/p\\u003e\\n            \\u003cp id=\\\"errorReturned\\\" class=\\\"text-danger mdi mdi-alert-circle\\\" data-id=\\\"feedback\\\"\\n              data-skcomponent=\\\"skerror\\\" aria-live=\\\"assertive\\\"\\u003e\\u003c/p\\u003e\\n            \\u003cform id=\\\"securityKeyForm\\\" method=\\\"post\\\"\\u003e\\n              \\u003cdiv class=\\\"float-label placeholder-shown\\\"\\u003e\\n                \\u003cinput type=\\\"hidden\\\" name=\\\"attestation\\\" id=\\\"attestation\\\" /\\u003e\\n                \\u003cbutton data-skcomponent=\\\"skbutton\\\" data-skbuttontype=\\\"form-submit\\\" class=\\\"hidden-button\\\" data-skbuttonvalue=\\\"submit\\\"\\n              data-skform=\\\"securityKeyForm\\\" id=\\\"submitAttestationButton\\\" \\u003e\\u003c/button\\u003e\\n              \\u003c/div\\u003e\\n            \\u003c/form\\u003e\\n            \\u003cform id=\\\"registerMFADevice\\\"\\u003e\\n              \\u003cdiv class=\\\"d-flex flex-column\\\"\\u003e\\n                {{#if continueButtonLabel}}\\n                \\u003cbutton id=\\\"fidoButton\\\" data-id=\\\"button\\\" type=\\\"submit\\\" class=\\\"btn btn-primary mb-3\\\" \\u003e\\n                {{continueButtonLabel}}\\n              \\u003c/button\\u003e\\n                {{/if}}\\n              \\u003c/div\\u003e\\n            \\u003c/form\\u003e\\n          \\u003c/div\\u003e\\n        \\u003c/main\\u003e\\n      \\u003c/div\\u003e\\n    \\u003c/div\\u003e\\n  \\u003c/div\\u003e\\n\\u003c/div\\u003e\"},\"customScript\":{\"value\":\"/**\\r\\n *\\r\\n * FIDO Registration\\r\\n *\\r\\n * Creates a new credential to register with PingOne MFA using WebAuthn\\r\\n *\\r\\n */\\r\\n\\r\\n/**\\r\\n * If the string is valid JSON, parse it and return the object. If it's not\\r\\n * valid JSON, return the string or throw an error\\r\\n *\\r\\n * @param strVal - The stringified JSON object that you want to parse\\r\\n * @returns The parsed JSON as an object\\r\\n */\\r\\nconst parseJSONIfNeeded = (strVal) =\\u003e {\\r\\n  try {\\r\\n    return JSON.parse(strVal);\\r\\n  } catch (error) {\\r\\n    if (error.name === 'SyntaxError') {\\r\\n      if (error.message === '\\\"[object Object]\\\" is not valid JSON') {\\r\\n        // In most cases, this means that the method argument was given as a\\r\\n        // JSON object, so we can just proceed\\r\\n        // But, you can add debugging here if you need to investigate further\\r\\n        return strVal;\\r\\n      } else {\\r\\n        // This means that we didn't get an object passed into the method as\\r\\n        // an object and there's a syntax problem with it\\r\\n        throw new Error(\\r\\n          'JSON parsing failed due to improper JSON syntax found in public key credential request options string.',\\r\\n          {cause: error}\\r\\n        );\\r\\n      }\\r\\n    } else {\\r\\n      // This is unexpected and needs further debugging\\r\\n      throw new Error('Unexpected error. Please try again.', {\\r\\n        cause: error,\\r\\n      });\\r\\n    }\\r\\n  }\\r\\n};\\r\\n\\r\\n/**\\r\\n * It converts a list of credentials from the format given in the public key\\r\\n * credentials object to the format used by the WebAuthn API\\r\\n *\\r\\n * @param list - The list of credentials to convert.\\r\\n * @returns An array of credential objects which includes the type of\\r\\n * credential and its ID\\r\\n */\\r\\nconst credentialListConversion = (list) =\\u003e {\\r\\n  const credList = [];\\r\\n\\r\\n  for (let i = 0; i \\u003c list.length; i++) {\\r\\n    const cred = {\\r\\n      type: list[i].type,\\r\\n      id: new Uint8Array(list[i].id),\\r\\n    };\\r\\n\\r\\n    if (list[i].transports) {\\r\\n      cred.transports = list[i].transports;\\r\\n    }\\r\\n\\r\\n    credList.push(cred);\\r\\n  }\\r\\n\\r\\n  return credList;\\r\\n};\\r\\n\\r\\n/**\\r\\n * It converts a binary array to a base64 string\\r\\n *\\r\\n * @param bin - The binary data to convert to base64\\r\\n * @returns A string of base64 encoded data\\r\\n */\\r\\nconst toBase64Str = (bin) =\\u003e {\\r\\n  return btoa(String.fromCharCode.apply(null, new Uint8Array(bin)));\\r\\n};\\r\\n\\r\\n/**\\r\\n * It takes an error object and updates the error message element with the error\\r\\n * message\\r\\n *\\r\\n * @param error - The error object or message to display.\\r\\n */\\r\\nconst updateErrorMessageText = (error) =\\u003e {\\r\\n  const errorMsgElement = document.getElementById('errorMsg');\\r\\n  console.log(\\\"Error\\\", error);\\r\\n\\r\\n  if (errorMsgElement) {\\r\\n    if (error) {\\r\\n      errorMsgElement.innerHTML = error;\\r\\n      if (error.cause) {\\r\\n        errorMsgElement.innerHTML += ' ' + error.cause;\\r\\n      }\\r\\n    } else {\\r\\n      errorMsgElement.innerHTML = 'Unknown error';\\r\\n    }\\r\\n  } else {\\r\\n    throw new Error('Missing error message element');\\r\\n  }\\r\\n};\\r\\n\\r\\n/**\\r\\n * It resets the error message element's text to an empty string\\r\\n */\\r\\nconst resetErrorMessageText = () =\\u003e {\\r\\n  const errorMsgElement = document.getElementById('errorMsg');\\r\\n  if (errorMsgElement) {\\r\\n    errorMsgElement.innerHTML = '';\\r\\n  }\\r\\n};\\r\\n\\r\\n/**\\r\\n * It takes a new public key credential object and returns the attestation to\\r\\n * submit to PingOne MFA to register the device\\r\\n *\\r\\n * @param credential - The credential object returned by WebAuthn API's create\\r\\n * credential function\\r\\n * @returns An attestation object\\r\\n */\\r\\nconst buildAttestationForPingOneMFA = (credential) =\\u003e {\\r\\n  const newCredentialInfo = {};\\r\\n  const response = {};\\r\\n\\r\\n  if (credential.id) {\\r\\n    newCredentialInfo.id = credential.id;\\r\\n  }\\r\\n\\r\\n  if (credential.type) {\\r\\n    newCredentialInfo.type = credential.type;\\r\\n  }\\r\\n\\r\\n  if (credential.rawId) {\\r\\n    newCredentialInfo.rawId = toBase64Str(credential.rawId);\\r\\n  }\\r\\n\\r\\n  if (!credential.response) {\\r\\n    throw \\\"Missing 'response' attribute in credential response\\\";\\r\\n  }\\r\\n\\r\\n  response.clientDataJSON = toBase64Str(credential.response.clientDataJSON);\\r\\n\\r\\n  response.attestationObject = toBase64Str(\\r\\n    credential.response.attestationObject\\r\\n  );\\r\\n\\r\\n  newCredentialInfo.response = response;\\r\\n  return newCredentialInfo;\\r\\n};\\r\\n\\r\\n/**\\r\\n * It takes the options object and converts it into a format that the\\r\\n * [create]{https://www.w3.org/TR/webauthn-2/#sctn-createCredential}\\r\\n * function from the WebAuthn API can understand\\r\\n *\\r\\n * @param options - The options object\\r\\n * @returns the publicKeyCreateCredentialsOptions object that the WebAuthn API\\r\\n * expects\\r\\n */\\r\\nconst buildPubKeyCredentialOptions = (options) =\\u003e {\\r\\n  const createCredentialsOptions = {};\\r\\n\\r\\n  createCredentialsOptions.rp = options.rp;\\r\\n  createCredentialsOptions.user = options.user;\\r\\n  createCredentialsOptions.user.id = new Uint8Array(options.user.id);\\r\\n  createCredentialsOptions.challenge = new Uint8Array(options.challenge);\\r\\n  createCredentialsOptions.pubKeyCredParams = options.pubKeyCredParams;\\r\\n\\r\\n  // Additional (optional) configuration\\r\\n  if (options.timeout) {\\r\\n    createCredentialsOptions.timeout = options.timeout;\\r\\n  }\\r\\n\\r\\n  if (options.excludeCredentials) {\\r\\n    createCredentialsOptions.excludeCredentials = credentialListConversion(\\r\\n      options.excludeCredentials\\r\\n    );\\r\\n  }\\r\\n\\r\\n  if (options.authenticatorSelection) {\\r\\n    createCredentialsOptions.authenticatorSelection =\\r\\n      options.authenticatorSelection;\\r\\n  }\\r\\n\\r\\n  // Require [roaming or cross platform authenticators]{https://www.w3.org/TR/webauthn-2/#roaming-authenticators}\\r\\n  createCredentialsOptions.authenticatorSelection.authenticatorAttachment =\\r\\n    'cross-platform';\\r\\n\\r\\n  if (options.attestation) {\\r\\n    createCredentialsOptions.attestation = options.attestation;\\r\\n  }\\r\\n\\r\\n  if (options.extensions) {\\r\\n    createCredentialsOptions.extensions = options.extensions;\\r\\n  }\\r\\n\\r\\n  return createCredentialsOptions;\\r\\n};\\r\\n\\r\\n/**\\r\\n * It creates a new WebAuthn credential and returns the information needed to\\r\\n * register it with PingOne MFA\\r\\n *\\r\\n * @param options - A JSON object that contains the options needed to create a\\r\\n * new credential using the WebAuthn API\\r\\n * @returns The attestation object is being returned\\r\\n */\\r\\nconst registerNewPubKeyCredAndSubmitAttestation = async (options) =\\u003e {\\r\\n  options = parseJSONIfNeeded(options);\\r\\n\\r\\n  // Build the options object to pass in during the WebAuthn create call\\r\\n  const publicKeyCredentialCreationOptions =\\r\\n    buildPubKeyCredentialOptions(options);\\r\\n\\r\\n  try {\\r\\n    // Call WebAuthn's\\r\\n    // [create]{https://www.w3.org/TR/webauthn-2/#sctn-createCredential}\\r\\n    // method to register a new credential\\r\\n    const pubKeyCred = await navigator.credentials.create({\\r\\n      publicKey: publicKeyCredentialCreationOptions,\\r\\n    });\\r\\n\\r\\n    // Info needed for registering the device with PingOne MFA\\r\\n    const attestedCred = buildAttestationForPingOneMFA(pubKeyCred);\\r\\n\\r\\n    // Send new credential info to (PingOne MFA) server for verification and\\r\\n    // registration\\r\\n    const attestationElement = document.getElementById('attestation');\\r\\n    const attestationBtn = document.getElementById('submitAttestationButton');\\r\\n    // Updates the value in the element that'll have its value submitted\\r\\n    attestationElement.value = JSON.stringify(attestedCred);\\r\\n    // Submit the new credential info and advance the flow\\r\\n    attestationBtn.click();\\r\\n\\r\\n    return JSON.stringify(attestedCred);\\r\\n  } catch (error) {\\r\\n    const WEBAUTHN_FAILED_MSG =\\r\\n      'Failed to use WebAuthn to create a new credential.';\\r\\n    throw new Error(WEBAUTHN_FAILED_MSG, {\\r\\n      cause: error,\\r\\n    });\\r\\n  }\\r\\n};\\r\\n\\r\\n/**\\r\\n * It takes the public key credential creation options from the flow variable,\\r\\n * creates a FIDO attestation, and returns the attestation\\r\\n *\\r\\n * @param event - The event object that is passed to the function.\\r\\n * @returns The attestation object is returned.\\r\\n */\\r\\nconst fidoRegistration = async (event) =\\u003e {\\r\\n  event?.preventDefault();\\r\\n  resetErrorMessageText();\\r\\n\\r\\n  const publicKeyCredentialCreationOptions =\\r\\n    '{{global.variables.publicKeyCredentialCreationOptions}}';\\r\\n\\r\\n  if (publicKeyCredentialCreationOptions) {\\r\\n    try {\\r\\n      return await registerNewPubKeyCredAndSubmitAttestation(\\r\\n        publicKeyCredentialCreationOptions\\r\\n      );\\r\\n    } catch (error) {\\r\\n      updateErrorMessageText(error);\\r\\n      return false;\\r\\n    }\\r\\n  } else {\\r\\n    // Missing Public Key Credential Creation Options\\r\\n    updateErrorMessageText('Missing credential creation options');\\r\\n  }\\r\\n};\\r\\n\\r\\n/**\\r\\n * Wait for page to load to start the FIDO registration process\\r\\n */\\r\\nif (document.readyState === 'loading') {\\r\\n  // Loading hasn't finished yet\\r\\n  document.addEventListener('DOMContentLoaded', fidoRegistration);\\r\\n} else {\\r\\n  // `DOMContentLoaded` has already fired\\r\\n  const fidoBtn = document.getElementById('fidoButton');\\r\\n  if (fidoBtn) {\\r\\n    fidoBtn.addEventListener('click', fidoRegistration);\\r\\n  }\\r\\n\\r\\n  return fidoRegistration();\\r\\n}\\r\\n\"},\"formFieldsList\":{\"value\":[{\"displayName\":\"attestation\",\"hashedVisibility\":false,\"preferredControlType\":\"textField\",\"preferredDataType\":\"string\",\"propertyName\":\"attestation\",\"value\":\"\"},{\"preferredControlType\":\"textField\",\"preferredDataType\":\"string\",\"propertyName\":\"buttonValue\"}]},\"inputSchema\":{\"value\":\"{\\n\\t\\\"type\\\": \\\"object\\\",\\n\\t\\\"properties\\\": {\\n\\t\\t\\t\\\"title\\\": {\\n\\t\\t\\t\\t\\t\\\"type\\\": \\\"string\\\",\\n\\t\\t\\t\\t\\t\\\"displayName\\\": \\\"Title\\\",\\n\\t\\t\\t\\t\\t\\\"preferredControlType\\\": \\\"textField\\\",\\n\\t\\t\\t\\t\\t\\\"enableParameters\\\": true,\\n\\t\\t\\t\\t\\t\\\"propertyName\\\": \\\"title\\\"\\n\\t\\t\\t},\\n\\t\\t\\t\\\"text\\\": {\\n\\t\\t\\t\\t\\\"type\\\": \\\"string\\\",\\n\\t\\t\\t\\t\\\"displayName\\\": \\\"Text\\\",\\n\\t\\t\\t\\t\\\"preferredControlType\\\": \\\"textField\\\",\\n\\t\\t\\t\\t\\\"enableParameters\\\": true\\n\\t\\t\\t},\\n\\t\\t\\t\\\"continueButtonLabel\\\": {\\n\\t\\t\\t\\t\\\"type\\\": \\\"string\\\",\\n\\t\\t\\t\\t\\\"displayName\\\": \\\"Continue Button Label\\\",\\n\\t\\t\\t\\t\\\"preferredControlType\\\": \\\"textField\\\",\\n\\t\\t\\t\\t\\\"enableParameters\\\": true\\n\\t\\t\\t}\\n\\t}\\n}\"},\"nodeDescription\":{\"value\":\"Starts FIDO device registration using WebAuthn API\"},\"nodeTitle\":{\"value\":\"FIDO device registration\"},\"outputSchema\":{\"value\":\"{\\r\\n  \\\"type\\\": \\\"object\\\",\\r\\n  \\\"properties\\\": {\\r\\n    \\\"attestation\\\": {\\r\\n      \\\"type\\\": \\\"string\\\",\\r\\n      \\\"displayName\\\": \\\"attestation\\\",\\r\\n      \\\"preferredControlType\\\": \\\"textField\\\",\\r\\n      \\\"propertyName\\\": \\\"attestation\\\"\\r\\n    }\\r\\n  }\\r\\n}\\r\\n\"},\"text\":{\"value\":\"[\\n  {\\n    \\\"children\\\": [\\n      {\\n        \\\"text\\\": \\\"Follow instructions to register Passkey.\\\"\\n      }\\n    ]\\n  }\\n]\"},\"title\":{\"value\":\"[\\n  {\\n    \\\"children\\\": [\\n      {\\n        \\\"text\\\": \\\"Register Passkey\\\"\\n      }\\n    ]\\n  }\\n]\"}},\"status\":\"configured\",\"type\":\"trigger\"},\"grabbable\":true,\"group\":\"nodes\",\"locked\":false,\"pannable\":false,\"position\":{\"x\":938,\"y\":2224},\"removed\":false,\"selectable\":true,\"selected\":false},{\"classes\":\"\",\"data\":{\"capabilityName\":\"customHTMLTemplate\",\"connectionId\":\"867ed4363b2bc21c860085ad2baa817d\",\"connectorId\":\"httpConnector\",\"id\":\"wlqkk6ovop\",\"idUnique\":\"et8lgte305\",\"label\":\"HTTP\",\"name\":\"Http\",\"nodeType\":\"CONNECTION\",\"properties\":{\"customCSS\":{\"value\":\".hidden-button{\\r\\n    display: none;\\r\\n}\"},\"customHTML\":{\"value\":\"\\u003cdiv class=\\\"end-user-nano\\\"\\u003e\\r\\n  \\u003cdiv\\r\\n    class=\\\"bg-light d-flex flex-column justify-content-center align-items-center position-absolute top-0 start-0 bottom-0 end-0 overflow-auto\\\"\\u003e\\r\\n    \\u003cform id=\\\"webAuthnSupportForm\\\" method=\\\"post\\\"\\u003e\\r\\n      \\u003cinput type=\\\"hidden\\\" name=\\\"webAuthnSupport\\\" id=\\\"webAuthnSupport\\\" /\\u003e\\r\\n      \\u003cbutton type=\\\"hidden\\\" data-skcomponent=\\\"skbutton\\\" data-skbuttontype=\\\"form-submit\\\" class=\\\"d-none\\\"\\r\\n        data-skbuttonvalue=\\\"submit\\\" data-skform=\\\"webAuthnSupportForm\\\" id=\\\"webAuthnSupportSubmitBtn\\\"\\u003e\\u003c/button\\u003e\\r\\n    \\u003c/form\\u003e\\r\\n  \\u003c/div\\u003e\\r\\n\\u003c/div\\u003e\"},\"customScript\":{\"value\":\"/**\\r\\n *\\r\\n * WebAuthn API Check\\r\\n *\\r\\n * Check whether the WebAuthn API is available and submit the corresponding\\r\\n * boolean value to advance the flow.\\r\\n *\\r\\n */\\r\\n\\r\\n/**\\r\\n * If the browser doesn't support WebAuthn, then set the value of the hidden\\r\\n * input field to false and submit the form. If the browser does support\\r\\n * WebAuthn, then set the value of the hidden input field to true and submit the\\r\\n * form\\r\\n *\\r\\n * @returns A boolean value representing WebAuthn API support.\\r\\n */\\r\\nconst webAuthnCheck = () =\\u003e {\\r\\n  if (!window.PublicKeyCredential) {\\r\\n    document.getElementById('webAuthnSupport').value = false;\\r\\n    document.getElementById('webAuthnSupportSubmitBtn').click();\\r\\n    return false;\\r\\n  }\\r\\n\\r\\n  document.getElementById('webAuthnSupport').value = true;\\r\\n  document.getElementById('webAuthnSupportSubmitBtn').click();\\r\\n  return true;\\r\\n};\\r\\n\\r\\n/**\\r\\n * Wait for page to load to start the FIDO authentication process\\r\\n */\\r\\nif (document.readyState === 'loading') {\\r\\n  // Loading hasn't finished yet\\r\\n  document.addEventListener('DOMContentLoaded', webAuthnCheck);\\r\\n} else {\\r\\n  // `DOMContentLoaded` has already fired\\r\\n  const webAuthnSupportSubmitBtn = document.getElementById(\\r\\n    'webAuthnSupportSubmitBtn'\\r\\n  );\\r\\n  if (webAuthnSupportSubmitBtn) {\\r\\n    webAuthnSupportSubmitBtn.addEventListener('click', webAuthnCheck);\\r\\n  }\\r\\n\\r\\n  return webAuthnCheck();\\r\\n}\\r\\n\"},\"formFieldsList\":{\"value\":[{\"displayName\":\"webAuthnSupport\",\"hashedVisibility\":false,\"preferredControlType\":\"textField\",\"preferredDataType\":\"boolean\",\"propertyName\":\"webAuthnSupport\",\"value\":\"\"},{\"preferredControlType\":\"textField\",\"preferredDataType\":\"string\",\"propertyName\":\"buttonValue\"}]},\"nodeDescription\":{\"value\":\"Checks whether the first device is capable of using the WebAuthn API\"},\"nodeTitle\":{\"value\":\"WebAuthn compatibility check\"},\"outputSchema\":{\"value\":\"{\\r\\n\\t\\\"type\\\": \\\"object\\\",\\r\\n\\t\\\"properties\\\": {\\r\\n\\t\\t\\\"buttonValue\\\": {\\r\\n\\t\\t\\t\\\"type\\\": \\\"string\\\",\\r\\n\\t\\t\\t\\\"propertyName\\\": \\\"buttonValue\\\"\\r\\n\\t\\t},\\r\\n\\t\\t\\\"webAuthnSupport\\\": {\\r\\n\\t\\t\\t\\\"type\\\": \\\"boolean\\\",\\r\\n\\t\\t\\t\\\"propertyName\\\": \\\"webAuthnSupport\\\"\\r\\n\\t\\t}\\r\\n\\t}\\r\\n}\"}},\"status\":\"configured\",\"type\":\"trigger\"},\"grabbable\":true,\"group\":\"nodes\",\"locked