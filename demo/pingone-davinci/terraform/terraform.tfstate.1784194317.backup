nyName}}\\\" /\\u003e\\n                        \\u003ch1 id=\\\"title\\\" class=\\\"text-center mb-4\\\"\\u003e\\n                            {{title}}\\n                        \\u003c/h1\\u003e\\n                        \\u003cp class=\\\"text-muted text-center\\\"\\u003e{{text}}\\u003c/p\\u003e\\n\\n                        \\u003c!-- Generic Error Message --\\u003e\\n                        \\u003cp class=\\\"text-danger mdi mdi-alert-circle text-center\\\" data-id=\\\"feedback\\\"\\n                            data-skcomponent=\\\"skerror\\\" aria-live=\\\"assertive\\\"\\u003e\\u003c/p\\u003e\\n\\n                        \\u003c!-- Field Validation Error Messages --\\u003e\\n                        \\u003cp class=\\\"text-danger mdi mdi-alert-circle text-center\\\" data-skerrorid=\\\"passcode\\\"\\n                            data-skcomponent=\\\"skerrormessage\\\" aria-live=\\\"assertive\\\"\\u003e\\u003c/p\\u003e\\n\\n                        \\u003cp id=\\\"resendMessage\\\" class=\\\"text-success mdi mdi-check-circle text-center\\\"  \\n                            style=\\\"display: {{#if resendMessage}} block; {{else}} none; {{/if}}\\\"aria-live=\\\"assertive\\\"\\u003e{{resendMessage}}\\u003c/p\\u003e\\n\\n                        \\u003cform id=\\\"otp-form\\\" data-id=\\\"otp-form\\\"\\u003e\\n                            \\u003cdiv class=\\\"mb-4 form-floating\\\"\\u003e\\n                                \\u003cinput class=\\\"form-control text-center otp-control\\\" id=\\\"passcode\\\" type=\\\"text\\\" autocomplete=\\\"on\\\" maxlength=\\\"8\\\" aria-required=\\\"true\\\" placeholder=\\\"Verification Code\\\" /\\u003e\\n                                \\u003clabel class=\\\"form-label\\\" for=\\\"passcode\\\"\\u003eVerification Code\\u003c/label\\u003e\\n                            \\u003c/div\\u003e\\n                           \\n                            \\u003cdiv class=\\\"d-flex flex-column\\\"\\u003e\\n                                \\u003cbutton id=\\\"submit\\\" type=\\\"submit\\\" class=\\\"btn btn-primary mb-3\\\" data-skcomponent=\\\"skbutton\\\"\\n                                    data-skbuttontype=\\\"form-submit\\\" data-skform=\\\"otp-form\\\" data-skbuttonvalue=\\\"VERIFY\\\"\\u003e\\n                                    Continue\\n                                \\u003c/button\\u003e\\n                                \\u003cbutton id=\\\"resend\\\" type=\\\"button\\\" class=\\\"btn btn-link mb-3\\\" data-skcomponent=\\\"skbutton\\\"\\n                                    data-skbuttontype=\\\"next-event\\\" data-skbuttonvalue=\\\"RESEND\\\"\\u003e\\n                                    Resend verification code\\n                                \\u003c/button\\u003e\\n                            \\u003c/div\\u003e\\n                        \\u003c/form\\u003e\\n                    \\u003c/div\\u003e\\n                \\u003c/main\\u003e\\n            \\u003c/div\\u003e\\n        \\u003c/div\\u003e\\n    \\u003c/div\\u003e\\n\\u003c/div\\u003e\"},\"customScript\":{\"value\":\"/**\\n * Sets focus to the DOM element specified by its ID.\\n * @param {string} id - The ID of the DOM element to focus.\\n */\\nconst setFieldFocus = (id) =\\u003e {\\n    const element = document.getElementById(id);\\n    if (element) {\\n        element.focus();\\n    } else {\\n        console.log(`Element with ID ${id} not found.`);\\n    }\\n};\\n\\n/**\\n * Initializes the application by setting the focus to a specific field.\\n */\\nconst start = () =\\u003e {\\n    setFieldFocus(\\\"passcode\\\");\\n};\\n\\n// Ensure the script runs after the DOM is fully loaded\\nif (document.readyState === \\\"loading\\\") {\\n    document.addEventListener(\\\"DOMContentLoaded\\\", start);\\n} else {\\n    start();\\n}\\n\\n\"},\"formFieldsList\":{\"value\":[{\"hashedVisibility\":false,\"preferredControlType\":\"textField\",\"preferredDataType\":\"string\",\"propertyName\":\"buttonValue\",\"value\":\"\"},{\"displayName\":\"Passco