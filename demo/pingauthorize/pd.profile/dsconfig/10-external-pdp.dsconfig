# Applied automatically at container setup (server-profile dsconfig batch).
#
# EMBEDDED PDP mode: PingAuthorize evaluates a self-contained deployment package
# baked into the image (/opt/in/banking.deploymentpackage, exported from the PAP),
# so decisions are stable, fast, and independent of the PAP at runtime — and they
# survive restarts and apply to every instance.
#
# The banking policy: permit list_accounts / get_balance / open_account /
# make_payment; DENY make_payment above 2000 AUD (agent channel, human step-up).
# Request attributes (actionName, amount, ...) bind via each attribute's `request`
# resolver. The PAP (pingauthorize-pap) is used only for AUTHORING; regenerate
# banking.deploymentpackage when the policy changes.

set-policy-decision-service-prop \
    --set pdp-mode:embedded \
    --set trust-framework-version:v2 \
    --set deployment-package-source-type:static-file \
    --set "deployment-package</opt/in/banking.deploymentpackage"
