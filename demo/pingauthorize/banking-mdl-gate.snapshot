ransfer (Bob's out-of-band CIBA approval) OR the RAR match. Reconstructed from banking-staff-approval.deploymentpackage (source snapshot e37ad2da was never exported to git).","shared":false,"disabled":false,"combiningAlgorithm":{"algorithm":"DenyOverrides","evaluateAll":false},"children":[{"id":"e051c46c-fd77-407d-b9fc-25df9e515388","type":"Rule"},{"id":"4a0716a7-c2d4-4e58-af96-3db49c8848c0","type":"Rule"},{"id":"e69d2cd0-8255-42b9-8e10-4d8b1a506d8b","type":"Rule"},{"id":"170b2fad-30c9-4cd5-ada2-1d29d98e662b","type":"Rule"},{"id":"4057cc49-459b-4a1b-aeac-5846e5b3f1ec","type":"Rule"},{"id":"2ef9f47d-d4ba-4d6d-8964-d4a600f7fcc9","type":"Rule"},{"id":"751fbf1a-5f17-45c8-a700-a738b96eee92","type":"Rule"},{"id":"f615cc34-d544-4e9c-8f8d-4e6c1a1f93a2","type":"Rule"},{"id":"5a5d5099-475d-4379-ab41-7bc6ca7d71d1","type":"Rule"},{"id":"b5bd2cb9-d8f0-483a-a70c-9df62b5fcc6a","type":"Rule"},{"id":"609bd903-70a0-4c5b-a43e-b9c95c090b54","type":"Rule"},{"id":"c3d874a7-6dd3-4461-b201-9e7a0e54bc24","type":"Rule"}],"repetitionSettings":null,"permissions":{"inherit":true,"rolePermissions":[]},"condition":{"empty":{}},"targets":[],"statements":[],"properties":[]},{"id":"e51688ff-1dc9-4b6c-bb36-8af64d02e9d1","version":"9a92748a-035d-4079-a9c8-f4f28044d83e","type":"PolicySet","name":"Global Decision Point","description":"","shared":false,"disabled":false,"combiningAlgorithm":{"algorithm":"DenyOverrides","evaluateAll":false},"children":[{"id":"1bfca6f3-ff79-45da-8017-11009ca260d8","type":"Policy"}],"permissions":{"inherit":true,"rolePermissions":[]},"condition":{"empty":{}},"targets":[],"statements":[],"properties":[]},{"type":"SnapshotPackageFile$PackageSeparator"},{"type":"SnapshotPackageFile$EndOfPackage"},{"@class":"DataStreamFooter","digest":"D+6CDHuPNjzz5+gkufp//uOLlyNxB9t2k+fiNXhodig="}]