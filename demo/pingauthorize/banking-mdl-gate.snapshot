[{"@class":"DataStreamHeader","kind":"SnapshotHeader","version":4},{"type":"SnapshotPackageFile$PackageHeader","snapshotId":"2a9cf0f0-8138-4736-82c0-979c3ebb4889","snapshotFileVersion":4,"applicationVersion":"11.1.0.0"},{"objectType":"AttributeDefinition","id":"d3601f49-8768-408e-9104-8b4fb3afcfff","version":"162d8e03-2004-4ce7-8b89-990c24622a7a","type":"ATTRIBUTE","name":"actionName","fullName":"actionName","description":"","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"objectType":"AttributeDefinition","id":"e93e97e7-da6e-46fb-aed6-4687fd9cc7d2","version":"5521b72a-4a27-41df-97d6-6d746a34d80f","type":"ATTRIBUTE","name":"amount","fullName":"amount","description":"","parentId":null,"numberOfChildren":null,"valueType":"NUMBER","defaultValue":"0","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"objectType":"AttributeDefinition","id":"3abb6938-fbaf-46af-8bdc-41f49bc966bc","version":"d5b12667-d892-478d-9358-e900f0aec7e9","type":"ATTRIBUTE","name":"currency","fullName":"currency","description":"ISO 4217 payment currency, sent flat by the adapter, so a consent recorded in one currency cannot satisfy a payment in another.","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"objectType":"AttributeDefinition","id":"d12763b5-ee9f-459d-8b2f-909f179e9f46","version":"04393c2b-277d-4d75-8493-437c1e6becfa","type":"ATTRIBUTE","name":"identity_proofing_present","fullName":"identity_proofing_present","description":"","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"true","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"objectType":"AttributeDefinition","id":"4983c989-07d6-4664-8845-a47462495b17","version":"7462e722-f55e-4f5d-995a-4f3fe9a355b0","type":"ATTRIBUTE","name":"onBehalfOf","fullName":"onBehalfOf","description":"The principal the agent acts for (subject.properties.on_behalf_of == the user token sub, e.g. alice), sent flat by the adapter. Lookup key for the ConsentDirectory PIP.","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"objectType":"AttributeDefinition","id":"607db049-4679-4ad4-a009-c66db7537ce9","version":"3e92a6ff-6e6d-4c40-a775-d1f87470be37","type":"ATTRIBUTE","name":"purpose","fullName":"purpose","description":"","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"objectType":"AttributeDefinition","id":"8b1b9b7f-2f75-4cc5-812c-4232dbab85c5","version":"321c7dda-ff26-4125-98af-52b4d7958cd7","type":"ATTRIBUTE","name":"rar_amount_ok","fullName":"rar_amount_ok","description":"","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"false","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"objectType":"AttributeDefinition","id":"69698fbc-1c29-48ff-a16e-df9f07c7eaed","version":"77a918ba-0bcc-4a02-8825-2fda08e71473","type":"ATTRIBUTE","name":"rar_creditor_ok","fullName":"rar_creditor_ok","description":"","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"false","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"objectType":"AttributeDefinition","id":"3b666084-491b-48d3-a105-5c050eede7cd","version":"5542f61b-f1bc-4693-b5a4-e60955bf8a31","type":"ATTRIBUTE","name":"to_account","fullName":"to_account","description":"The payment's destination (creditor) account, sent flat by the adapter. Passed to the ConsentDirectory PIP to match the consented creditor.","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"objectType":"AttributeDefinition","id":"fa7fc4c1-722a-45b7-886c-ac396228b35d","version":"08fdb7df-5437-4252-8e0e-3bb85368f7a7","type":"ATTRIBUTE","name":"token_aud","fullName":"token_aud","description":"","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"objectType":"AttributeDefinition","id":"fe331926-24ba-4822-86f3-f3daace2b8ca","version":"1d0e0877-0765-4b8f-a05b-d80e3ab875e3","type":"ATTRIBUTE","name":"user_acr","fullName":"user_acr","description":"","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"objectType":"AttributeDefinition","id":"81b4ac87-1bdf-4942-a908-3434c6e8a26a","version":"9e25fdca-49db-46ce-9e52-d4f5c471180a","type":"ATTRIBUTE","name":"user_scope","fullName":"user_scope","description":"","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"objectType":"ServiceDefinition","id":"3c7262b0-27ee-4f0a-b00b-b0de70ab470d","version":"d1bffb7f-122f-4758-aca1-3a197f3d5dd0","type":"SERVICE","name":"ConsentDirectory","fullName":"ConsentDirectory","description":"PIP over the ID Partners consent directory (GET /consents/check): matches subject + amount <= consented + creditor + currency. ASSURANCE WARNING: what this reports is APP-ASSERTED consent — the BFF recorded it after a passkey ceremony that signed a RANDOM challenge, not a signature over this payment. The consent row can be produced without the signature, so it is NOT non-repudiable and would NOT satisfy PSD2 RTS Art.5 dynamic linking. Demo-grade evidence only. See demo/TRANSACTION-AUTHORIZATION.md section 2.","parentId":null,"numberOfChildren":null,"valueType":"JSON","serviceType":"RESTFUL","secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"serviceSettings":{"serviceSettingsType":"RestSettings","description":"SERVICE: RESTFUL; Verb = GET; Content Type: null","restAuthenticationType":"NONE","urlFormat":"https://proofing-directory-staging.up.railway.app/consents/check?subject={{4983c989-07d6-4664-8845-a47462495b17}}&creditor={{3b666084-491b-48d3-a105-5c050eede7cd}}&amount={{e93e97e7-da6e-46fb-aed6-4687fd9cc7d2}}&currency={{3abb6938-fbaf-46af-8bdc-41f49bc966bc}}","verb":"GET","headers":[],"responseHandling":{"returnFullResponse":false},"authenticationAttributes":{}},"cacheSettings":null,"serviceResilience":{"maximumConcurrentRequests":2,"maximumRequestsPerSecond":1000000.0,"timeoutMilliseconds":2000,"maximumRetryCount":2,"holdoffMilliseconds":1000,"retryStrategy":"BACKOFF","retryJitter":10.0,"circuitBreaker":null},"valueProcessor":null,"properties":[]},{"objectType":"AttributeDefinition","id":"b31b73ce-0b8e-484b-b45e-3af239f06990","version":"7e00ad64-b34b-40ed-9903-4e7398be75a7","type":"ATTRIBUTE","name":"consent_assurance","fullName":"consent_assurance","description":"The assurance level ACTUALLY ACHIEVED for the consent covering this payment, from the ConsentDirectory PIP ($.assurance). device-signed = a paired device signed over the transaction hash (dynamically linked, artefact retained, PSD2 RTS Art.5-shaped). device-approved = a paired device approved but sent no signature (presence, not agreement). app-asserted = browser passkey signed a RANDOM challenge; the app asserts the rest — NOT non-repudiable. Resolved only for make_payment. Defaults to app-asserted so an unknown level is treated as the WEAKEST, never the strongest.","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"app-asserted","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"service","id":"3c7262b0-27ee-4f0a-b00b-b0de70ab470d","condition":{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},"valueProcessor":{"type":"json-path","expression":"$.assurance","valueType":"STRING","name":""},"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"objectType":"AttributeDefinition","id":"6e9214c7-7b5f-429f-b772-78fb74eaedc8","version":"ce8005ce-bf64-44af-957d-05202fdff85a","type":"ATTRIBUTE","name":"consent_covered","fullName":"consent_covered","description":"TRUE when the consent directory holds an AUTHORIZED consent for this principal covering this payment (amount <= consented cap, matching creditor and currency). Resolved from the ConsentDirectory PIP's 'covered' field; only resolved for make_payment. ASSURANCE: app-asserted, NOT non-repudiable — the recorded consent is not a signature over this payment (demo/TRANSACTION-AUTHORIZATION.md section 2). Defaults to false so a directory outage or timeout fails CLOSED to step-up.","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"false","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"service","id":"3c7262b0-27ee-4f0a-b00b-b0de70ab470d","condition":{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},"valueProcessor":{"type":"json-path","expression":"$.covered","valueType":"STRING","name":""},"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"type":"SnapshotPackageFile$PackageSeparator"},{"id":"aba21bfa-9ee8-472e-8119-f35a39b3c0e4","version":"e91c2963-680c-44fb-b074-f15e84d6f218","type":"Statement","name":"Identity proofing required","description":"","shared":false,"code":"identity-proofing-required","appliesTo":"DENY","appliesIf":"FINAL_DECISION_MATCHES","payload":"{\"proofing\": true, \"doctype\": \"org.iso.18013.5.1.mDL\", \"message\": \"Present your mobile Driver's Licence (mDL) to open an account.\"}","obligatory":true,"permissions":{"inherit":true,"rolePermissions":[]},"attributes":[],"services":[]},{"id":"1760a727-032e-4db4-9863-633a440d71c7","version":"fdffc6e6-dc70-4829-b680-f3d9d8b845e7","type":"Statement","name":"Identity proofing required (payment destination)","description":"","shared":false,"code":"identity-proofing-required","appliesTo":"DENY","appliesIf":"FINAL_DECISION_MATCHES","payload":"{\"proofing\": true, \"doctype\": \"org.iso.18013.5.1.mDL\", \"message\": \"Present your mobile Driver's Licence (mDL) to verify the destination account before money can be paid into it.\"}","obligatory":true,"permissions":{"inherit":true,"rolePermissions":[]},"attributes":[],"services":[]},{"id":"dc6596d0-e89e-493a-be55-9abb40e52faf","version":"1db1fe6f-d5ec-4743-b938-44f89534ef22","type":"Statement","name":"Step-up required","description":"","shared":false,"code":"step-up-required","appliesTo":"DENY","appliesIf":"FINAL_DECISION_MATCHES","payload":"{\"step_up\": true, \"scope\": \"banking:payments:transfer\", \"message\": \"This payment needs your approval. Please sign in to approve it.\"}","obligatory":true,"permissions":{"inherit":true,"rolePermissions":[]},"attributes":[],"services":[]},{"id":"67144082-c770-4f7c-b50a-e4bb2b003464","version":"8b12aec9-3872-4263-bd82-7391a9b01d70","type":"Statement","name":"Wrong audience","description":"","shared":false,"code":"denied-reason","appliesTo":"DENY","appliesIf":"FINAL_DECISION_MATCHES","payload":"{\"status\": 403, \"message\": \"invalid_audience\", \"detail\": \"This access token was minted for a different audience and cannot be used at the bank API (RFC 8707).\"}","obligatory":true,"permissions":{"inherit":true,"rolePermissions":[]},"attributes":[],"services":[]},{"id":"e051c46c-fd77-407d-b9fc-25df9e515388","version":"31e5d192-e8db-4763-8bd3-99790f27d1cb","type":"Rule","name":"Permit banking actions","description":"","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"statements":[],"targets":[],"effectSettings":{"type":"unconditionalPermit"},"condition":{"or":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"list_accounts"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"get_balance"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"open_account"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"access_mcp"}}}}]}},"properties":[]},{"id":"4a0716a7-c2d4-4e58-af96-3db49c8848c0","version":"e81279ec-3f9f-4efc-8060-70e815e882c7","type":"Rule","name":"Deny over-limit agent payment","description":"","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"statements":[],"targets":[],"effectSettings":{"type":"unconditionalDeny"},"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},{"comparison":{"left":{"attribute":{"id":"e93e97e7-da6e-46fb-aed6-4687fd9cc7d2"}},"op":"GreaterThan","right":{"constant":{"value":"2000"}}}}]}},"properties":[]},{"id":"751fbf1a-5f17-45c8-a700-a738b96eee92","version":"e15d5f30-049d-442a-ad04-803c57e910ed","type":"Rule","name":"Require identity proofing for origination","description":"mDL identity-proofing gate: deny open_account unless a verified identity-proofing activity exists (identity_proofing_present==true). Adapter reports true when the gate switch is off, so this is a no-op until the switch is flipped on. [DISABLED 2026-07-24: gate moved to the PAYMENT (see 'Require identity proofing for payment destination') — origination is ungated; per-account proofing is enforced when money moves INTO the account.]","shared":false,"disabled":true,"permissions":{"inherit":true,"rolePermissions":[]},"statements":["aba21bfa-9ee8-472e-8119-f35a39b3c0e4"],"targets":[],"effectSettings":{"type":"unconditionalDeny"},"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"open_account"}}}},{"comparison":{"left":{"attribute":{"id":"d12763b5-ee9f-459d-8b2f-909f179e9f46"}},"op":"NotEquals","right":{"constant":{"value":"true"}}}}]}},"properties":[]},{"id":"5a5d5099-475d-4379-ab41-7bc6ca7d71d1","version":"6524d088-924d-4ceb-a944-c4c10b4ea608","type":"Rule","name":"Require identity proofing for payment destination","description":"mDL identity-proofing gate on the PAYMENT (per-account): deny make_payment unless the DESTINATION account (to_account) holds a verified identity-proofing activity — identity_proofing_present is computed by the AuthZEN adapter against the proofing directory for the payment's to_account. Origination is ungated; money cannot move INTO an un-proofed account.","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"statements":["1760a727-032e-4db4-9863-633a440d71c7"],"targets":[],"effectSettings":{"type":"unconditionalDeny"},"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},{"comparison":{"left":{"attribute":{"id":"d12763b5-ee9f-459d-8b2f-909f179e9f46"}},"op":"NotEquals","right":{"constant":{"value":"true"}}}}]}},"properties":[]},{"id":"170b2fad-30c9-4cd5-ada2-1d29d98e662b","version":"068abacf-de7b-4478-b807-3eb48caa3751","type":"Rule","name":"Deny over-limit payment authorization","description":"","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"statements":[],"targets":[],"effectSettings":{"type":"unconditionalDeny"},"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"607db049-4679-4ad4-a009-c66db7537ce9"}},"op":"Equals","right":{"constant":{"value":"payment_initiation"}}}},{"comparison":{"left":{"attribute":{"id":"e93e97e7-da6e-46fb-aed6-4687fd9cc7d2"}},"op":"GreaterThan","right":{"constant":{"value":"2000"}}}}]}},"properties":[]},{"id":"e69d2cd0-8255-42b9-8e10-4d8b1a506d8b","version":"07f5b53f-4816-4fff-a06b-86cde4aed33d","type":"Rule","name":"Permit payment authorization","description":"","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"statements":[],"targets":[],"effectSettings":{"type":"unconditionalPermit"},"condition":{"comparison":{"left":{"attribute":{"id":"607db049-4679-4ad4-a009-c66db7537ce9"}},"op":"Equals","right":{"constant":{"value":"payment_initiation"}}}},"properties":[]},{"id":"2ef9f47d-d4ba-4d6d-8964-d4a600f7fcc9","version":"7473f026-8d28-4327-bbdd-97b9c58326d9","type":"Rule","name":"Deny wrong-audience token","description":"","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"statements":["67144082-c770-4f7c-b50a-e4bb2b003464"],"targets":[],"effectSettings":{"type":"unconditionalDeny"},"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"fa7fc4c1-722a-45b7-886c-ac396228b35d"}},"op":"NotEquals","right":{"constant":{"value":""}}}},{"comparison":{"left":{"attribute":{"id":"fa7fc4c1-722a-45b7-886c-ac396228b35d"}},"op":"NotEquals","right":{"constant":{"value":"https://api.northwind.example/bank"}}}}]}},"properties":[]},{"id":"f615cc34-d544-4e9c-8f8d-4e6c1a1f93a2","version":"f752acbd-00ed-421d-b537-de21d20cfa01","type":"Rule","name":"Require a DEVICE-SIGNED consent for large payments (DISABLED)","description":"ARMED SWITCH, currently DISABLED. Denies a payment > AUD 500 that is carried ONLY by an app-asserted consent — i.e. the browser-passkey path, where the signature covers a random challenge and not this payment. Enable this once the approver app signs the transaction hash (assurance device-signed); until then it would deny every interactive payment, because the consents on record are app-asserted. Deliberately left disabled rather than omitted, so the honest bar is visible in the policy and arming it is a one-flag change. See demo/TRANSACTION-AUTHORIZATION.md sections 2 and 6. NOTE: no obligation is attached — the step-up statement is private to the sibling rule. When arming this, also attach a step-up statement so the caller gets a challenge rather than a bare denial.","shared":false,"disabled":true,"permissions":{"inherit":true,"rolePermissions":[]},"statements":[],"targets":[],"effectSettings":{"type":"unconditionalDeny"},"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},{"comparison":{"left":{"attribute":{"id":"e93e97e7-da6e-46fb-aed6-4687fd9cc7d2"}},"op":"GreaterThan","right":{"constant":{"value":"500"}}}},{"not":{"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"8b1b9b7f-2f75-4cc5-812c-4232dbab85c5"}},"op":"Equals","right":{"constant":{"value":"true"}}}},{"comparison":{"left":{"attribute":{"id":"69698fbc-1c29-48ff-a16e-df9f07c7eaed"}},"op":"Equals","right":{"constant":{"value":"true"}}}}]}}}},{"not":{"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"fe331926-24ba-4822-86f3-f3daace2b8ca"}},"op":"Equals","right":{"constant":{"value":"urn:northwind:loa:staff-approval"}}}},{"comparison":{"left":{"attribute":{"id":"81b4ac87-1bdf-4942-a908-3434c6e8a26a"}},"op":"Contains","right":{"constant":{"value":"banking:payments:transfer"}}}}]}}}},{"comparison":{"left":{"attribute":{"id":"6e9214c7-7b5f-429f-b772-78fb74eaedc8"}},"op":"Equals","right":{"constant":{"value":"true"}}}},{"comparison":{"left":{"attribute":{"id":"b31b73ce-0b8e-484b-b45e-3af239f06990"}},"op":"NotEquals","right":{"constant":{"value":"device-signed"}}}}]}},"properties":[]},{"id":"4057cc49-459b-4a1b-aeac-5846e5b3f1ec","version":"f9c24d2c-36bf-4c52-9e2d-a7f975d7dbf0","type":"Rule","name":"Require step-up for large payment","description":"make_payment strictly > AUD 500 (and <= 2000) requires approval evidence: PERMIT if ANY of (a) the interactive channel's matching RFC 9396 RAR consent (rar_amount_ok AND rar_creditor_ok); (b) the autonomous STAFF channel (acr urn:northwind:loa:staff-approval AND banking:payments:transfer scope); or (c) consent_covered — the ConsentDirectory PIP found a RECORDED authorized consent for this principal covering this amount/creditor/currency. Otherwise DENY + step-up advice. *** ASSURANCE LABEL — disjunct (c) is DEMO-GRADE ONLY. *** It accepts APP-ASSERTED consent: the BFF wrote the consent row after a passkey ceremony that signed a RANDOM challenge, so the signature does not cover this payment and the row can be produced without it. (c) is NOT non-repudiable and would NOT satisfy PSD2 RTS Art.5 dynamic linking — unlike (a), where the instruction at least rides as RAR in the token. (c) exists to unblock the demo loop; target state is CIBA + RAR. See demo/TRANSACTION-AUTHORIZATION.md sections 2, 5, 6.","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"statements":["dc6596d0-e89e-493a-be55-9abb40e52faf"],"targets":[],"effectSettings":{"type":"unconditionalDeny"},"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},{"comparison":{"left":{"attribute":{"id":"e93e97e7-da6e-46fb-aed6-4687fd9cc7d2"}},"op":"GreaterThan","right":{"constant":{"value":"500"}}}},{"not":{"condition":{"comparison":{"left":{"attribute":{"id":"e93e97e7-da6e-46fb-aed6-4687fd9cc7d2"}},"op":"GreaterThan","right":{"constant":{"value":"2000"}}}}}},{"not":{"condition":{"or":{"conditions":[{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"8b1b9b7f-2f75-4cc5-812c-4232dbab85c5"}},"op":"Equals","right":{"constant":{"value":"true"}}}},{"comparison":{"left":{"attribute":{"id":"69698fbc-1c29-48ff-a16e-df9f07c7eaed"}},"op":"Equals","right":{"constant":{"value":"true"}}}}]}},{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"fe331926-24ba-4822-86f3-f3daace2b8ca"}},"op":"Equals","right":{"constant":{"value":"urn:northwind:loa:staff-approval"}}}},{"comparison":{"left":{"attribute":{"id":"81b4ac87-1bdf-4942-a908-3434c6e8a26a"}},"op":"Contains","right":{"constant":{"value":"banking:payments:transfer"}}}}]}},{"comparison":{"left":{"attribute":{"id":"6e9214c7-7b5f-429f-b772-78fb74eaedc8"}},"op":"Equals","right":{"constant":{"value":"true"}}}}]}}}}]}},"properties":[]},{"id":"1bfca6f3-ff79-45da-8017-11009ca260d8","version":"2a9d5432-52e0-4277-94e0-60bd3fb6dedd","type":"Policy","name":"Agentic Banking Authorization","description":"Staff-approval channel: step-up satisfied by acr=urn:northwind:loa:staff-approval + banking:payments:transfer (Bob's out-of-band CIBA approval) OR the RAR match. Reconstructed from banking-staff-approval.deploymentpackage (source snapshot e37ad2da was never exported to git).","shared":false,"disabled":false,"combiningAlgorithm":{"algorithm":"DenyOverrides","evaluateAll":false},"children":[{"id":"e051c46c-fd77-407d-b9fc-25df9e515388","type":"Rule"},{"id":"4a0716a7-c2d4-4e58-af96-3db49c8848c0","type":"Rule"},{"id":"e69d2cd0-8255-42b9-8e10-4d8b1a506d8b","type":"Rule"},{"id":"170b2fad-30c9-4cd5-ada2-1d29d98e662b","type":"Rule"},{"id":"4057cc49-459b-4a1b-aeac-5846e5b3f1ec","type":"Rule"},{"id":"2ef9f47d-d4ba-4d6d-8964-d4a600f7fcc9","type":"Rule"},{"id":"751fbf1a-5f17-45c8-a700-a738b96eee92","type":"Rule"},{"id":"f615cc34-d544-4e9c-8f8d-4e6c1a1f93a2","type":"Rule"},{"id":"5a5d5099-475d-4379-ab41-7bc6ca7d71d1","type":"Rule"}],"repetitionSettings":null,"permissions":{"inherit":true,"rolePermissions":[]},"statements":[],"targets":[],"condition":{"empty":{}},"properties":[]},{"id":"e51688ff-1dc9-4b6c-bb36-8af64d02e9d1","version":"8eea83ea-e1f0-4a47-8b26-7524673cfef8","type":"PolicySet","name":"Global Decision Point","description":"","shared":false,"disabled":false,"combiningAlgorithm":{"algorithm":"DenyOverrides","evaluateAll":false},"children":[{"id":"1bfca6f3-ff79-45da-8017-11009ca260d8","type":"Policy"}],"permissions":{"inherit":true,"rolePermissions":[]},"statements":[],"targets":[],"condition":{"empty":{}},"properties":[]},{"type":"SnapshotPackageFile$PackageSeparator"},{"type":"SnapshotPackageFile$EndOfPackage"},{"@class":"DataStreamFooter","digest":"qY7tQmPkJ6D/mb2m6UfeFX/aRpzbd8QSUUmWBrwfFvU="}]