,"version":"e9c45164-6f4d-452c-b34a-126bdbddb334","type":"ATTRIBUTE","name":"consent_covered","fullName":"consent_covered","description":"TRUE when the consent directory holds an AUTHORIZED consent for this principal covering this payment (amount <= consented cap, matching creditor and currency). Resolved from the ConsentDirectory PIP's 'covered' field; only resolved for make_payment. ASSURANCE: app-asserted, NOT non-repudiable — the recorded consent is not a signature over this payment (demo/TRANSACTION-AUTHORIZATION.md section 2). Defaults to false so a directory outage or timeout fails CLOSED to step-up.","parentId":null,"numberOfChildren":null,"valueType":"STRING","defaultValue":"false","repetitionSource":null,"cacheConfig":{"timeToLive":0,"scopeAttributeId":null,"strategy":"NO_CACHING"},"secret":false,"permissions":{"inherit":true,"rolePermissions":[]},"resolvers":[{"attributeResolverType":"service","id":"3c7262b0-27ee-4f0a-b00b-b0de70ab470d","condition":{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},"valueProcessor":{"type":"json-path","expression":"$.covered","valueType":"STRING","name":""},"name":null}],"querySettings":null,"valueProcessor":null,"properties":[]},{"type":"SnapshotPackageFile$PackageSeparator"},{"id":"aba21bfa-9ee8-472e-8119-f35a39b3c0e4","version":"77ad1eab-000b-4806-83a7-d9887e4168eb","type":"Statement","name":"Identity proofing required","description":"","shared":false,"code":"identity-proofing-required","appliesTo":"DENY","appliesIf":"FINAL_DECISION_MATCHES","payload":"{\"proofing\": true, \"doctype\": \"org.iso.18013.5.1.mDL\", \"message\": \"Present your mobile Driver's Licence (mDL) to open an account.\"}","obligatory":true,"permissions":{"inherit":true,"rolePermissions":[]},"services":[],"attributes":[]},{"id":"dc6596d0-e89e-493a-be55-9abb40e52faf","version":"d519f233-69b8-4ab5-add4-0841af060723","type":"Statement","name":"Step-up required","description":"","shared":false,"code":"step-up-required","appliesTo":"DENY","appliesIf":"FINAL_DECISION_MATCHES","payload":"{\"step_up\": true, \"scope\": \"banking:payments:transfer\", \"message\": \"This payment needs your approval. Please sign in to approve it.\"}","obligatory":true,"permissions":{"inherit":true,"rolePermissions":[]},"services":[],"attributes":[]},{"id":"67144082-c770-4f7c-b50a-e4bb2b003464","version":"59ff68ba-477e-40d5-9de8-ef781873fc3d","type":"Statement","name":"Wrong audience","description":"","shared":false,"code":"denied-reason","appliesTo":"DENY","appliesIf":"FINAL_DECISION_MATCHES","payload":"{\"status\": 403, \"message\": \"invalid_audience\", \"detail\": \"This access token was minted for a different audience and cannot be used at the bank API (RFC 8707).\"}","obligatory":true,"permissions":{"inherit":true,"rolePermissions":[]},"services":[],"attributes":[]},{"id":"e051c46c-fd77-407d-b9fc-25df9e515388","version":"0174355c-5f46-4f56-8194-22c2e31bf0ee","type":"Rule","name":"Permit banking actions","description":"","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"effectSettings":{"type":"unconditionalPermit"},"statements":[],"targets":[],"condition":{"or":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"list_accounts"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"get_balance"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"open_account"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"access_mcp"}}}}]}},"properties":[]},{"id":"