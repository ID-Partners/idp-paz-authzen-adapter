,"right":{"constant":{"value":"payment_initiation"}}}},"targets":[],"statements":[],"effectSettings":{"type":"unconditionalPermit"},"properties":[]},{"id":"2ef9f47d-d4ba-4d6d-8964-d4a600f7fcc9","version":"4b91d16a-3f32-4ecb-9b33-0e517f77fb50","type":"Rule","name":"Deny wrong-audience token","description":"","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"fa7fc4c1-722a-45b7-886c-ac396228b35d"}},"op":"NotEquals","right":{"constant":{"value":""}}}},{"comparison":{"left":{"attribute":{"id":"fa7fc4c1-722a-45b7-886c-ac396228b35d"}},"op":"NotEquals","right":{"constant":{"value":"https://api.northwind.example/bank"}}}}]}},"targets":[],"statements":["67144082-c770-4f7c-b50a-e4bb2b003464"],"effectSettings":{"type":"unconditionalDeny"},"properties":[]},{"id":"4a0716a7-c2d4-4e58-af96-3db49c8848c0","version":"cb51a01b-1ffa-4ad7-ba06-57f5792a6936","type":"Rule","name":"Deny over-limit agent payment","description":"","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},{"comparison":{"left":{"attribute":{"id":"e93e97e7-da6e-46fb-aed6-4687fd9cc7d2"}},"op":"GreaterThan","right":{"constant":{"value":"2000"}}}}]}},"targets":[],"statements":[],"effectSettings":{"type":"unconditionalDeny"},"properties":[]},{"id":"e051c46c-fd77-407d-b9fc-25df9e515388","version":"4a0ba05b-7f3c-476a-bafd-a8c574e399e2","type":"Rule","name":"Permit banking actions","description":"","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"condition":{"or":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"list_accounts"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"get_balance"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"open_account"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"access_mcp"}}}}]}},"targets":[],"statements":[],"effectSettings":{"type":"unconditionalPermit"},"properties":[]},{"id":"b5bd2cb9-d8f0-483a-a70c-9df62b5fcc6a","version":"1dd3189a-6651-4a08-bfb6-29ae7e63373b","type":"Rule","name":"Permit grant evaluation (held+open)","description":"Grant-evaluation actions permitted; the sibling deny rule (DenyOverrides) blocks when the account is not held/open.","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"condition":{"or":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"read_balance"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"read_transactions"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"initiate_payment"}}}}]}},"targets":[],"statements":[],"effectSettings":{"type":"unconditionalPermit"},"properties":[]},{"id":"751fbf1a-5f17-45c8-a700-a738b96eee92","version":"56bb606a-031b-4fef-a466-9d1b78c1c818","type":"Rule","name":"Require identity proofing for origination","description":"mDL identity-proofing gate: deny open_account unless a verified identity-proofing activity exists (identity_proofing_present==true). Adapter reports true when the gate switch is off, so this is a no-op until the switch is flipped on. [DISABLED 2026-07-24: gate moved to the PAYMENT (see 'Require identity proofing for payment destination') — origination is ungated; per-account proofing is enforced when money moves INTO the account.]","shared":false,"disabled":true,"permissions":{"inherit":true,"rolePermissions":[]},"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"open_account"}}}},{"comparison":{"left":{"attribute":{"id":"d12763b5-ee9f-459d-8b2f-909f179e9f46"}},"op":"NotEquals","right":{"constant":{"value":"true"}}}}]}},"targets":[],"statements":["aba21bfa-9ee8-472e-8119-f35a39b3c0e4"],"effectSettings":{"type":"unconditionalDeny"},"properties":[]},{"id":"5a5d5099-475d-4379-ab41-7bc6ca7d71d1","version":"b497dd71-2572-4820-ad4d-3c5506114470","type":"Rule","name":"Require identity proofing for payment destination","description":"mDL identity-proofing gate on the PAYMENT (per-account): deny make_payment unless the DESTINATION account (to_account) holds a verified identity-proofing activity — identity_proofing_present is computed by the AuthZEN adapter against the proofing directory for the payment's to_account. Origination is ungated; money cannot move INTO an un-proofed account.","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},{"comparison":{"left":{"attribute":{"id":"d12763b5-ee9f-459d-8b2f-909f179e9f46"}},"op":"NotEquals","right":{"constant":{"value":"true"}}}}]}},"targets":[],"statements":["1760a727-032e-4db4-9863-633a440d71c7"],"effectSettings":{"type":"unconditionalDeny"},"properties":[]},{"id":"f615cc34-d544-4e9c-8f8d-4e6c1a1f93a2","version":"e587fcef-491d-4078-9baa-8259f89c3dcd","type":"Rule","name":"Require a DEVICE-SIGNED consent for large payments (DISABLED)","description":"ARMED SWITCH, currently DISABLED. Denies a payment > AUD 500 that is carried ONLY by an app-asserted consent — i.e. the browser-passkey path, where the signature covers a random challenge and not this payment. Enable this once the approver app signs the transaction hash (assurance device-signed); until then it would deny every interactive payment, because the consents on record are app-asserted. Deliberately left disabled rather than omitted, so the honest bar is visible in the policy and arming it is a one-flag change. See demo/TRANSACTION-AUTHORIZATION.md sections 2 and 6. NOTE: no obligation is attached — the step-up statement is private to the sibling rule. When arming this, also attach a step-up statement so the caller gets a challenge rather than a bare denial.","shared":false,"disabled":true,"permissions":{"inherit":true,"rolePermissions":[]},"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},{"comparison":{"left":{"attribute":{"id":"e93e97e7-da6e-46fb-aed6-4687fd9cc7d2"}},"op":"GreaterThan","right":{"constant":{"value":"500"}}}},{"not":{"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"8b1b9b7f-2f75-4cc5-812c-4232dbab85c5"}},"op":"Equals","right":{"constant":{"value":"true"}}}},{"comparison":{"left":{"attribute":{"id":"69698fbc-1c29-48ff-a16e-df9f07c7eaed"}},"op":"Equals","right":{"constant":{"value":"true"}}}}]}}}},{"not":{"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"fe331926-24ba-4822-86f3-f3daace2b8ca"}},"op":"Equals","right":{"constant":{"value":"urn:northwind:loa:staff-approval"}}}},{"comparison":{"left":{"attribute":{"id":"81b4ac87-1bdf-4942-a908-3434c6e8a26a"}},"op":"Contains","right":{"constant":{"value":"banking:payments:transfer"}}}}]}}}},{"comparison":{"left":{"attribute":{"id":"6e9214c7-7b5f-429f-b772-78fb74eaedc8"}},"op":"Equals","right":{"constant":{"value":"true"}}}},{"comparison":{"left":{"attribute":{"id":"b31b73ce-0b8e-484b-b45e-3af239f06990"}},"op":"NotEquals","right":{"constant":{"value":"device-signed"}}}}]}},"targets":[],"statements":[],"effectSettings":{"type":"unconditionalDeny"},"properties":[]},{"id":"4057cc49-459b-4a1b-aeac-5846e5b3f1ec","version":"593d5507-7fbb-445c-b45c-eb32e5dfbf83","type":"Rule","name":"Require step-up for large payment","description":"make_payment strictly > AUD 500 (and <= 2000) requires approval evidence: PERMIT if ANY of (a) the interactive channel's matching RFC 9396 RAR consent (rar_amount_ok AND rar_creditor_ok); (b) the autonomous STAFF channel (acr urn:northwind:loa:staff-approval AND banking:payments:transfer scope); or (c) consent_covered — the ConsentDirectory PIP found a RECORDED authorized consent for this principal covering this amount/creditor/currency. Otherwise DENY + step-up advice. *** ASSURANCE LABEL — disjunct (c) is DEMO-GRADE ONLY. *** It accepts APP-ASSERTED consent: the BFF wrote the consent row after a passkey ceremony that signed a RANDOM challenge, so the signature does not cover this payment and the row can be produced without it. (c) is NOT non-repudiable and would NOT satisfy PSD2 RTS Art.5 dynamic linking — unlike (a), where the instruction at least rides as RAR in the token. (c) exists to unblock the demo loop; target state is CIBA + RAR. See demo/TRANSACTION-AUTHORIZATION.md sections 2, 5, 6.","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},{"comparison":{"left":{"attribute":{"id":"e93e97e7-da6e-46fb-aed6-4687fd9cc7d2"}},"op":"GreaterThan","right":{"constant":{"value":"500"}}}},{"not":{"condition":{"comparison":{"left":{"attribute":{"id":"e93e97e7-da6e-46fb-aed6-4687fd9cc7d2"}},"op":"GreaterThan","right":{"constant":{"value":"2000"}}}}}},{"not":{"condition":{"or":{"conditions":[{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"8b1b9b7f-2f75-4cc5-812c-4232dbab85c5"}},"op":"Equals","right":{"constant":{"value":"true"}}}},{"comparison":{"left":{"attribute":{"id":"69698fbc-1c29-48ff-a16e-df9f07c7eaed"}},"op":"Equals","right":{"constant":{"value":"true"}}}}]}},{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"fe331926-24ba-4822-86f3-f3daace2b8ca"}},"op":"Equals","right":{"constant":{"value":"urn:northwind:loa:staff-approval"}}}},{"comparison":{"left":{"attribute":{"id":"81b4ac87-1bdf-4942-a908-3434c6e8a26a"}},"op":"Contains","right":{"constant":{"value":"banking:payments:transfer"}}}}]}},{"comparison":{"left":{"attribute":{"id":"6e9214c7-7b5f-429f-b772-78fb74eaedc8"}},"op":"Equals","right":{"constant":{"value":"true"}}}}]}}}}]}},"targets":[],"statements":["dc6596d0-e89e-493a-be55-9abb40e52faf"],"effectSettings":{"type":"unconditionalDeny"},"properties":[]},{"id":"609bd903-70a0-4c5b-a43e-b9c95c090b54","version":"9d6cf5e3-f9d5-4576-8227-adfbd76895c0","type":"Rule","name":"Deny grant evaluation — account not held/open","description":"Deny a grant-evaluation action when the subject does not currently hold the resource account open (account_held_open != true). DenyOverrides makes this win.","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"condition":{"and":{"conditions":[{"or":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"read_balance"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"read_transactions"}}}},{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"initiate_payment"}}}}]}},{"comparison":{"left":{"attribute":{"id":"aadbaf4a-5e99-4d79-8bde-5d60dec0390d"}},"op":"NotEquals","right":{"constant":{"value":"true"}}}}]}},"targets":[],"statemen