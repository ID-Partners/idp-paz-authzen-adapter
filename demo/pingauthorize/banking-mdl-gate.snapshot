 PIP found a RECORDED authorized consent for this principal covering this amount/creditor/currency. Otherwise DENY + step-up advice. *** ASSURANCE LABEL — disjunct (c) is DEMO-GRADE ONLY. *** It accepts APP-ASSERTED consent: the BFF wrote the consent row after a passkey ceremony that signed a RANDOM challenge, so the signature does not cover this payment and the row can be produced without it. (c) is NOT non-repudiable and would NOT satisfy PSD2 RTS Art.5 dynamic linking — unlike (a), where the instruction at least rides as RAR in the token. (c) exists to unblock the demo loop; target state is CIBA + RAR. See demo/TRANSACTION-AUTHORIZATION.md sections 2, 5, 6.","shared":false,"disabled":false,"permissions":{"inherit":true,"rolePermissions":[]},"effectSettings":{"type":"unconditionalDeny"},"statements":["dc6596d0-e89e-493a-be55-9abb40e52faf"],"targets":[],"condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"d3601f49-8768-408e-9104-8b4fb3afcfff"}},"op":"Equals","right":{"constant":{"value":"make_payment"}}}},{"comparison":{"left":{"attribute":{"id":"e93e97e7-da6e-46fb-aed6-4687fd9cc7d2"}},"op":"GreaterThan","right":{"constant":{"value":"500"}}}},{"not":{"condition":{"comparison":{"left":{"attribute":{"id":"e93e97e7-da6e-46fb-aed6-4687fd9cc7d2"}},"op":"GreaterThan","right":{"constant":{"value":"2000"}}}}}},{"not":{"condition":{"or":{"conditions":[{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"8b1b9b7f-2f75-4cc5-812c-4232dbab85c5"}},"op":"Equals","right":{"constant":{"value":"true"}}}},{"comparison":{"left":{"attribute":{"id":"69698fbc-1c29-48ff-a16e-df9f07c7eaed"}},"op":"Equals","right":{"constant":{"value":"true"}}}}]}},{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"fe331926-24ba-4822-86f3-f3daace2b8ca"}},"op":"Equals","right":{"constant":{"value":"urn:northwind:loa:staff-approval"}}}},{"comparison":{"left":{"attribute":{"id":"81b4ac87-1bdf-4942-a908-3434c6e8a26a"}},"op":"Contains","right":{"constant":{"value":"banking:payments:transfer"}}}}]}},{"comparison":{"left":{"attribute":{"id":"6e9214c7-7b5f-429f-b772-78fb74eaedc8"}},"op":"Equals","right":{"constant":{"value":"true"}}}}]}}}}]}},"properties":[]},{"id":"1bfca6f3-ff79-45da-8017-11009ca260d8","version":"a2511713-99bd-4db3-893e-db5226ffaea8","type":"Policy","name":"Agentic Banking Authorization","description":"Staff-approval channel: step-up satisfied by acr=urn:northwind:loa:staff-approval + banking:payments:transfer (Bob's out-of-band CIBA approval) OR the RAR match. Reconstructed from banking-staff-approval.deploymentpackage (source snapshot e37ad2da was never exported to git).","shared":false,"disabled":false,"combiningAlgorithm":{"algorithm":"DenyOverrides","evaluateAll":false},"children":[{"id":"e051c46c-fd77-407d-b9fc-25df9e515388","type":"Rule"},{"id":"4a0716a7-c2d4-4e58-af96-3db49c8848c0","type":"Rule"},{"id":"e69d2cd0-8255-42b9-8e10-4d8b1a506d8b","type":"Rule"},{"id":"170b2fad-30c9-4cd5-ada2-1d29d98e662b","type":"Rule"},{"id":"4057cc49-459b-4a1b-aeac-5846e5b3f1ec","type":"Rule"},{"id":"2ef9f47d-d4ba-4d6d-8964-d4a600f7fcc9","type":"Rule"},{"id":"751fbf1a-5f17-45c8-a700-a738b96eee92","type":"Rule"}],"repetitionSettings":null,"permissions":{"inherit":true,"rolePermissions":[]},"statements":[],"targets":[],"condition":{"empty":{}},"properties":[]},{"id":"e51688ff-1dc9-4b6c-bb36-8af64d02e9d1","version":"c7d98aef-eaae-4218-ab89-1fc5779acbfd","type":"PolicySet","name":"Global Decision Point","description":"","shared":false,"disabled":false,"combiningAlgorithm":{"algorithm":"DenyOverrides","evaluateAll":false},"children":[{"id":"1bfca6f3-ff79-45da-8017-11009ca260d8","type":"Policy"}],"permissions":{"inherit":true,"rolePermissions":[]},"statements":[],"targets":[],"condition":{"empty":{}},"properties":[]},{"type":"SnapshotPackageFile$PackageSeparator"},{"type":"SnapshotPackageFile$EndOfPackage"},{"@class":"DataStreamFooter","digest":"6EiYfG8IxW1qeTMVVLyrzrY0zr9TaXzurYL39nKVNIA="}]
