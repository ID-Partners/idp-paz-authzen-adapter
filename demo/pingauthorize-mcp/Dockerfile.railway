# Railway build of the PingAuthorize policy-manager MCP server.
# Vendored from Identity-CoPilot/pingauthorize-mcp-server so the demo can author
# PingAuthorize policies via the 66-tool MCP API. Reaches the PAP over Railway's
# private network; only its /mcp endpoint is public.
# Used via RAILWAY_DOCKERFILE_PATH=demo/pingauthorize-mcp/Dockerfile.railway
# (build context = git root, so COPY paths are repo-root-relative).
FROM python:3.12-slim
WORKDIR /app
COPY demo/pingauthorize-mcp/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY demo/pingauthorize-mcp/src/ ./src/
ENV MCP_HTTP_HOST=0.0.0.0 MCP_HTTP_PORT=8080 PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["python", "-m", "src.server"]
