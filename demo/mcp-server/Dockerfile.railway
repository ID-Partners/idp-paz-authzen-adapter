# Railway build of the bank MCP server.
# Used via RAILWAY_DOCKERFILE_PATH=demo/mcp-server/Dockerfile.railway — the build
# context is the git root, so COPY paths are repo-root-relative.
FROM python:3.12-slim

WORKDIR /app

COPY demo/mcp-server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY demo/mcp-server/ .

# Railway injects $PORT; default to 8090 for local runs.
ENV PORT=8090
EXPOSE 8090

CMD ["python", "server.py"]
