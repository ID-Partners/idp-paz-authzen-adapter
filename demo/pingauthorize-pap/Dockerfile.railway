# Railway build of the PingAuthorize Policy Editor (PAP).
# Used via RAILWAY_DOCKERFILE_PATH=demo/pingauthorize-pap/Dockerfile.railway —
# build context is the git root, so COPY paths are repo-root-relative.
#
# The PAP is where the demo's banking policy is authored/managed. PingAuthorize
# runs in EXTERNAL PDP mode pointing at this editor, so policy changes made here
# apply to decisions immediately. Same license as the server, injected at
# runtime from the PING_LICENSE env var by entrypoint-license.sh.
FROM pingidentity/pingauthorizepap:11.0.0.2-latest

ENV PING_IDENTITY_ACCEPT_EULA=YES
ENV LICENSE_DIR=/opt/in/instance

COPY --chmod=0755 demo/pingauthorize-pap/entrypoint-license.sh /opt/entrypoint-license.sh

EXPOSE 1443
ENTRYPOINT ["/opt/entrypoint-license.sh"]
CMD ["start-server"]
