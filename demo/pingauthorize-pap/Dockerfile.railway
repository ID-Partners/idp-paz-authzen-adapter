# Railway build of the PingAuthorize Policy Editor (PAP).
# Used via RAILWAY_DOCKERFILE_PATH=demo/pingauthorize-pap/Dockerfile.railway.
#
# LICENSING: DevOps-licensed — NO PingAuthorize.lic is baked and NO custom entrypoint
# writes one. The stock image's startup hooks fetch a fresh 30-day eval license when
# PING_IDENTITY_DEVOPS_USER / PING_IDENTITY_DEVOPS_KEY (+ PING_IDENTITY_ACCEPT_EULA=YES)
# are set as Railway service vars and NO license file exists. Every restart re-fetches, so
# licenses never expire (mirrors demo/pingfederate). The old entrypoint-license.sh execed
# /opt/bootstrap.sh directly, which SKIPPED the stock license-fetch hook — so we rely on the
# stock entrypoint instead. Do NOT re-add a static-license entrypoint or a COPY *.lic line:
# an existing license file takes precedence and disables the DevOps fetch.
FROM pingidentity/pingauthorizepap:11.0.0.2-latest

ENV PING_IDENTITY_ACCEPT_EULA=YES

EXPOSE 1443
CMD ["start-server"]
