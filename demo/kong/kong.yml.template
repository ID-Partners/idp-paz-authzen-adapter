# Kong OSS declarative (DB-less) config TEMPLATE for the agentic-banking demo.
#
# The __PLACEHOLDER__ tokens are substituted at container start by
# docker-entrypoint.sh from environment variables, so the same image works both
# in docker-compose (hostnames like bank-mcp) and on Railway (*.railway.internal):
#   __BANK_MCP_URL__   e.g. http://bank-mcp:8090   or http://bank-mcp.railway.internal:8090
#   __BANK_API_URL__   e.g. http://bank-api:8070   or http://bank-api.railway.internal:8070
#   __AUTHZEN_URL__    e.g. http://authzen-adapter:8080
# The AuthZEN API key is supplied natively via Kong's env vault (no templating).
#
# One Kong proxy fronts BOTH governed surfaces, each with its own PEP:
#   PEP #1  agent -> kong/mcp       -> bank-mcp/mcp    (MCP edge, coarse)
#   PEP #2  mcp   -> kong/bank/...  -> bank-api/...     (Resource Server, fine)
#
# require_dpop is false here so the pipeline can be brought up and tested with
# plain bearer tokens; flip both to true to enforce the sender-constraint.

_format_version: "3.0"

services:
  - name: bank-mcp-svc
    url: __BANK_MCP_URL__
    routes:
      - name: mcp-route
        paths:
          - /mcp
        strip_path: false
    plugins:
      - name: authzen-pdp
        config:
          authzen_url: "__AUTHZEN_URL__"
          authzen_api_key: "{vault://env/authzen-api-key}"
          pep_label: "PEP#1 (MCP edge)"
          style: "mcp"
          require_token: true
          require_dpop: false
          # Step-up: require a logged-in end user (X-User-Token). If absent, the
          # gateway challenges (401 login_required) so the app forces a PF login.
          require_user_login: true

  - name: bank-api-svc
    url: __BANK_API_URL__
    routes:
      - name: bank-route
        paths:
          - /bank
        strip_path: true
    plugins:
      - name: authzen-pdp
        config:
          authzen_url: "__AUTHZEN_URL__"
          authzen_api_key: "{vault://env/authzen-api-key}"
          pep_label: "PEP#2 (Bank API edge)"
          style: "rest"
          require_token: true
          require_dpop: false
